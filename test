-- ============================ AP BREAKER (scramble) ============================
-- Breaks other players' autoparry. Their autoparry connects to YOUR
-- Animator.AnimationPlayed and matches the attack AnimationId; if it can't match
-- the id, it can't parry. We swap your attack Animation for a CLONE with a random
-- AnimationId, so enemies receive an unrecognisable id and can't parry. Your damage
-- is unaffected - the hit is the separate CheckMeleeHit remote, not the animation.
--
-- CONFIRMED LIVE how the game plays M1s: Humanoid:LoadAnimation(anim) then
-- track:Play(). Both are colon-calls, which on this executor dispatch through
-- __namecall - hookfunction on the method reference does NOT catch them (that is
-- why the first version silently did nothing). So we hook __namecall and intercept
-- LoadAnimation by SHAPE (self is a Humanoid, arg is an Animation with an M1 id).
--
-- We deliberately do NOT call getnamecallmethod() - doing so corrupts the method for
-- the other __namecall hooks (No Fall Damage / Stamina) and breaks them. Reading
-- .ClassName is a property access (via __index), not a namecall, so it is safe and
-- does not recurse. We CLONE the Animation (never mutate the shared instance).
--
-- Covers the M1 combo (all captured M1 ids start with 1133078). Skills use other
-- ids and can be added to the prefix/idset later.
--[==[ AP BREAKER DISABLED (commented out) - it scrambles your attack id to a
-- random one that has no animation, so YOUR OWN character visibly T-poses / plays
-- nothing on each swing, which looks obviously like cheating. Damage still works
-- (the hit is decoupled), so a future version could scramble to a VALID benign
-- animation instead of a dead id. Kept here; uncomment to re-enable.
_0xa299._0xAPB = { enabled = false }
do
    pcall(function()
        if not hookmetamethod then return end
        local wrap = newcclosure or function(f) return f end
        local old
        old = hookmetamethod(game, "__namecall", wrap(function(self, ...)
            if _0xa299._0xAPB.enabled then
                local a = ...
                if typeof(self) == "Instance" and self.ClassName == "Humanoid"
                    and typeof(a) == "Instance" and a.ClassName == "Animation" then
                    local id = tostring(a.AnimationId):match("%d+")
                    if id and id:sub(1, 7) == "1133078" then
                        local ok, clone = pcall(function()
                            local c = a:Clone()
                            c.AnimationId = "rbxassetid://" .. tostring(math.random(1, 999999999))
                            return c
                        end)
                        if ok and clone then
                            return old(self, clone)
                        end
                    end
                end
            end
            return old(self, ...)
        end))
    end)
end

